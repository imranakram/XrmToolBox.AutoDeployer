<?xml version="1.0" encoding="utf-8"?>
<!-- Everything: plugin assembly, plugin package and web resources -->
<Project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <WatchFiles>
    <WatchFile>
      <PackageId>00000000-0000-0000-0000-000000000000</PackageId>
      <Path>C:\Github\XrmToolBox.AutoDeployer\Tests\TestBench\PluginAssembly\bin\Debug\net462\AutoDeployTest.Plugins.dll</Path>
      <Type>PluginAssembly</Type>
    </WatchFile>
    <WatchFile>
      <PackageId>7c2c3f3a-67d0-f111-a05b-7ced8d3ebe2f</PackageId>
      <PackageName>biz_AutoDeployTest.Package</PackageName>
      <Path>C:\Github\XrmToolBox.AutoDeployer\Tests\TestBench\PluginPackage\bin\Debug\AutoDeployTest.Package.1.0.0.nupkg</Path>
      <Type>PluginPackage</Type>
    </WatchFile>
  </WatchFiles>
  <WebResources>
    <DebounceMs>1500</DebounceMs>
    <Mappings>
      <WebResourceMapping>
        <CrmName>biz_/autodeploytest/scripts/test.js</CrmName>
        <IsActive>true</IsActive>
        <RelativePath>scripts\test.js</RelativePath>
      </WebResourceMapping>
      <WebResourceMapping>
        <CrmName>biz_/autodeploytest/styles/test.css</CrmName>
        <IsActive>true</IsActive>
        <RelativePath>styles\test.css</RelativePath>
      </WebResourceMapping>
      <WebResourceMapping>
        <CrmName>biz_/autodeploytest/pages/test.html</CrmName>
        <IsActive>true</IsActive>
        <RelativePath>pages\test.html</RelativePath>
      </WebResourceMapping>
    </Mappings>
    <Patterns>*.js
*.css
*.html</Patterns>
    <Prefix>biz_/autodeploytest</Prefix>
    <PublishEnabled>true</PublishEnabled>
    <RootPath>C:\Github\XrmToolBox.AutoDeployer\Tests\TestBench\WebResources</RootPath>
  </WebResources>
</Project>
