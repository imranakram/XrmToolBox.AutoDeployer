<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{6E1F3C2A-8B4D-4F7E-9A5C-2D8E1B7F4A93}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>XrmToolBox.AutoDeployer.Tests</RootNamespace>
    <AssemblyName>XrmToolBox.AutoDeployer.Tests</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <LangVersion>latest</LangVersion>
    <!-- The SDK and Tooling Connector need binding redirects, which a library doesn't get by default -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <!-- The plugin's Debug post-build moves its dll into bin\Debug\Plugins (for running XrmToolBox from bin),
       so reference the dll where each configuration leaves it, and use the project reference only for build order -->
  <PropertyGroup>
    <PluginOutput Condition=" '$(Configuration)' == 'Debug' ">..\..\XrmToolBox.AutoDeployer\bin\Debug\Plugins\</PluginOutput>
    <PluginOutput Condition=" '$(Configuration)' != 'Debug' ">..\..\XrmToolBox.AutoDeployer\bin\$(Configuration)\</PluginOutput>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ImranAkram.XTB.AutoDeployer">
