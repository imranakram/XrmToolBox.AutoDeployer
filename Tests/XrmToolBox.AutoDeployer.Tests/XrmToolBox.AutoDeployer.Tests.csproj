    <Reference Include="System.ServiceModel" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Fakes\FakeOrganizationService.cs" />
    <Compile Include="Integration\DataverseFixture.cs" />
    <Compile Include="Integration\WatcherIntegrationTests.cs" />
    <Compile Include="PluginPackageLookupTests.cs" />
    <Compile Include="ProjectFileTests.cs" />
